# --- Jira connection ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@email.com
JIRA_API_TOKEN=your-token-here
JIRA_PROJECT_KEY=your-scrum-project-key

# --- Gemini API (used by /ask and /assess) ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Database ---
# Local Postgres:
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/jira
# Neon (cloud) example: postgresql+psycopg://user:password@ep-xxxx.region.aws.neon.com/neondb?sslmode=require

# --- App login (HTTP Basic Auth protecting the whole app) ---
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-me

# --- Show generated SQL in /ask responses (true only for local debugging) ---
SHOW_SQL=false
